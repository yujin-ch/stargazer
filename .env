# The site's public address. Every absolute link (share text, preview cards) is built from this,
# so moving to a custom domain is a one-line change here (or set VITE_SITE_URL in Vercel).
VITE_SITE_URL=https://stargazer-jade-one.vercel.app
# A tip page (e.g. Ko-fi). Leave empty to hide the tip link.
VITE_TIP_URL=
